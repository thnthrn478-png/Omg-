InfoTab:CreateSection("ตารางอันดับผู้เล่นในเซิร์ฟเวอร์")

local LeaderboardParagraph = InfoTab:CreateParagraph({
   Title = "รายชื่อผู้เล่น & คะแนน",
   Content = "กำลังโหลดข้อมูล..."
})

task.spawn(function()
   while true do
      task.wait(1)
      local infoText = ""
      for _, player in pairs(Players:GetPlayers()) do
         local scoreText = "ไม่มีค่า Leaderstats"
         if player:FindFirstChild("leaderstats") then
            local stats = player.leaderstats:GetChildren()
            if #stats > 0 then
               scoreText = stats[1].Name .. ": " .. tostring(stats[1].Value)
            end
         end
         infoText = infoText .. "• " .. player.Name .. " (" .. scoreText .. ")\n"
      end
      LeaderboardParagraph:Set({
         Title = "รายชื่อผู้เล่น & คะแนน (" .. #Players:GetPlayers() .. " คนในเซิร์ฟ)",
         Content = infoText
      })
   end
end)

Rayfield:Notify({
